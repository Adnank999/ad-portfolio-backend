DATABASE_URL=postgresql://portfolio:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/portfolio
DATABASE_MAX_CONNECTIONS=10
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8080
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:3000
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
RUST_LOG=info,tower_http=info

# Contact form email delivery via Resend (backend only; independent of SMTP).
# Leave RESEND_API_KEY unset to disable sending; the form reports unavailability.
# Use a sender address on your verified Resend domain.
# RESEND_API_KEY=re_replace_me
# RESEND_FROM_EMAIL=Portfolio <contact@your-verified-domain.example>
# CONTACT_TO_EMAIL=your-inbox@example.com

R2_DIRECT_UPLOAD_ENABLED=false
# R2_ACCOUNT_ID=replace-with-32-character-account-id
# R2_ACCESS_KEY_ID=replace-me
# R2_SECRET_ACCESS_KEY=replace-me
# R2_STAGING_BUCKET=portfolio-upload-staging
# R2_PUBLIC_BUCKET=portfolio-media
# R2_PUBLIC_BASE_URL=https://media.example.com
# R2_PRESIGN_TTL_SECONDS=300

# Set real HTTPS origins above when deploying to Ubuntu.
# Keep SMTP_HOST unset to disable password recovery emails.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=replace-me
# SMTP_PASSWORD=replace-me
# SMTP_FROM=Portfolio <noreply@example.com>

# Optional AI content generation; credentials stay on the backend.
# AI_PROVIDER=gemini
# AI_API_KEY=replace-me
# AI_MODEL=gemini-3.5-flash-lite
